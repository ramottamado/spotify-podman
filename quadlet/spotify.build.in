[Unit]
Description=Spotify Image Build

[Service]
ExecStartPost=/bin/buildah prune
ExecStartPost=/bin/podman image prune -f

[Build]
ImageTag=tamado.codes/library/spotify:latest
SetWorkingDirectory=%HOMEDIR%/.config/containers/systemd/spotify
File=Containerfile
Pull=never
ForceRM=true
PodmanArgs=--no-cache
