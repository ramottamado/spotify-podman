FROM docker.io/library/ubuntu:26.04

LABEL org.opencontainers.image.description="The base Ubuntu 26.04 system for containerized Spotify client."

RUN DEBIAN_FRONTEND=noninteractive apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates locales \
    && echo 'en_US.UTF-8 UTF-8' >> /etc/locale.gen \
    && locale-gen \
    && locale -a | grep 'en_US.utf8' \
    && rm -rf /var/lib/apt/lists/*
ENV LANG en_US.utf8

ADD --chmod=644 https://download.spotify.com/debian/pubkey_5384CE82BA52C83A.asc /etc/apt/keyrings/spotify.asc

RUN echo "deb [signed-by=/etc/apt/keyrings/spotify.asc] https://repository.spotify.com testing non-free" \
    > /etc/apt/sources.list.d/spotify.list \
    && DEBIAN_FRONTEND=noninteractive apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    spotify-client pipewire-audio-client-libraries xdg-utils \
    fonts-noto-core fonts-noto-color-emoji fonts-noto-cjk \
    libgl1 libegl1 python3-gi rsync \
    && rm -rf /var/lib/apt/lists/*

COPY --chmod=644 org.gnome.Epiphany.desktop /usr/local/share/applications/
COPY --chmod=755 entrypoint.sh spotify-inhibitor.py default-browser /usr/local/bin/